PORT=4000
NODE_ENV=development

# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/mrsa_blaster
DATABASE_SSL=false

# Supabase on Render:
# In Supabase Dashboard, open Connect -> Session pooler and copy the connection string.
# Replace the local DATABASE_URL above with that complete Session pooler URI.
# Keep the database password private. Do not use the Project URL or Publishable Key here.
# Set DATABASE_SSL=true when using Supabase.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@[SESSION_POOLER_HOST]:5432/postgres
# DATABASE_SSL=true

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
SUPER_ADMIN_NAME=MrSa Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Razorpay Test Mode credentials (keep private; never use VITE_ prefix)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
